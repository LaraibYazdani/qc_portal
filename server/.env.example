# QC Portal API settings. Copy to server/.env (never commit the real file).
# The same names as the earlier Node API, so an existing backend/.env keeps working
# (it is read when server/.env does not exist).

# Database Configuration (MariaDB 10.4+ or MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qc_portal
DB_USER=your_db_user
DB_PASS=your_db_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Server Configuration. NODE_ENV=production also serves the built web app (frontend/build).
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Where design files are stored. Default: backend/uploads (phase 1's artwork is already there).
UPLOAD_DIR=

# Requests per IP per 15 minutes on /api. Factory terminals share one IP. Default 1000.
RATE_LIMIT_MAX=1000

# Set to 1 when running behind IIS or another reverse proxy (real client IPs in audit log)
TRUST_PROXY=

# Company that receives uploads from users with no company of their own (phase 1 group admins)
LEGACY_DEFAULT_COMPANY_CODE=BSPL-CORR

# SuccessFactors OData (read-only). OAuth SAML bearer is used when these three are set:
SF_BASE_URL=https://api44.sapsf.com
SF_COMPANY_ID=packagesli
SF_CLIENT_ID=
SF_PRIVATE_KEY=
SF_ECADMIN_USER_ID=
# Basic-auth fallback, only used when the OAuth settings are empty
SF_API_USER=
SF_API_PASS=
# true = fixed test employees instead of live SuccessFactors (development only)
SF_MOCK_MODE=false

# SAP IAS sign-in (OpenID Connect). Stays off until IAS_ENABLED=true and the redirect URI
# below is registered in the IAS admin console exactly as written here.
IAS_ENABLED=false
IAS_ISSUER=https://<tenant>.accounts.ondemand.com
IAS_CLIENT_ID=
IAS_CLIENT_SECRET=
IAS_REDIRECT_URI=https://<portal domain>/api/auth/ias/callback
# Optional: claim carrying the SuccessFactors employee ID (default employee_number)
IAS_EMPLOYEE_ID_CLAIM=
# Optional: endpoints, normally found automatically from the issuer
IAS_AUTHORIZE_URL=
IAS_TOKEN_URL=
IAS_JWKS_URL=
# Set to true when the portal is served over HTTPS (sign-in cookie marked Secure)
COOKIE_SECURE=false
