# Database Configuration (MariaDB 10.4+ or MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qc_portal
DB_USER=your_db_user
DB_PASS=your_db_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Requests per IP per 15 minutes on /api. Factory terminals share one IP. Default 1000.
RATE_LIMIT_MAX=1000

# Set to 1 when running behind IIS or another reverse proxy (real client IPs in audit log)
TRUST_PROXY=

# Company that receives uploads from users with no company of their own (phase 1 group admins)
LEGACY_DEFAULT_COMPANY_CODE=BSPL-CORR

# SuccessFactors OData (read-only service account). Used by `npm run sf:org-lookup` now, login sync later.
SF_BASE_URL=https://api44.sapsf.com
SF_COMPANY_ID=packagesli
SF_API_USER=
SF_API_PASS=
